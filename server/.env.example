# ── LLM (OpenAI-compatible endpoint) ─────────────────────
# Şirket içi vLLM / SGLang / LM Studio sunucusunun /v1 adresi
LLM_BASE_URL=http://your-llm-server:8080/v1
LLM_MODEL=Qwen/Qwen3-32B
LLM_API_KEY=                        # gerekli değilse boş bırak
LLM_TIMEOUT_SECONDS=180

# ── Thinking model desteği ────────────────────────────────
# Qwen3, Kimi-K2 gibi thinking destekli modeller için true yap
LLM_ENABLE_THINKING=false
# Thinking token bütçesi (enable_thinking=true iken geçerli)
LLM_THINKING_BUDGET=8192

# ── Pipeline ──────────────────────────────────────────────
MAX_REPAIR_ATTEMPTS=2

# ── Server ───────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_TITLE=Weekly Report API

# ── MongoDB ──────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=TeamSyncDb

# ── TFS / Azure DevOps Server ────────────────────────────
TFS_PAT=your-personal-access-token-here
TFS_BASE_URL=https://tfs02.sirket.com.tr/tfs
TFS_COLLECTION=HBTUYTMCollection
TFS_PROJECT=TeamSync

# ── Meeting pipeline ─────────────────────────────────────
WHISPER_LOCAL_MODEL_DIR=/path/to/models/whisper-small
PYANNOTE_DIARIZATION_CONFIG=/path/to/models/speaker-diarization-3.1/config.yaml
TEMP_DIR=/tmp/meetings
MAX_FILE_SIZE_MB=200
MEETING_WORKER_COUNT=1
