# JWT  (env var overrides appsettings.json via ASP.NET Core double-underscore convention)
JwtSettings__SecretKey=super-secret-key-at-least-32-characters-long

# Encryption (used for TFS PAT storage)
EncryptionSettings__AesKey=your-base64-encoded-32-byte-aes-key

# MongoDB
MongoDbSettings__ConnectionString=mongodb://localhost:27017
MongoDbSettings__DatabaseName=TeamSyncDb

# CORS  (comma-separated list overridden in appsettings.json per environment)
AllowedOrigins__0=http://localhost:5173
AllowedOrigins__1=http://localhost:3000

# VLM Image Generation (used by VlmImageService for project banner images)
VLM_BASE_URL=http://your-vlm-host/
VLM_API_KEY=your-vlm-api-key
VLM_MODEL=your-model-name
VLM_IMAGE_SIZE=1024x1024
VLM_TIMEOUT_SECONDS=8
# Optional: path to a PEM/CER CA certificate file for self-signed or corporate CA
VLM_CA_CERT_PATH=

# LLM Chat Completions (proxied via POST /api/llm/chat for WeeklySummary)
LLM_BASE_URL=http://your-llm-host/
LLM_API_KEY=your-llm-api-key
LLM_MODEL=your-model-name
# Optional: path to a PEM/CER CA certificate file for self-signed or corporate CA
LLM_CA_CERT_PATH=
